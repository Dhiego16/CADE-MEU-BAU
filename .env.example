# Firebase (Console → Configurações do projeto → Seus apps → app Web)
# Copie para .env.local para testar localmente e cadastre as mesmas variáveis na Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Histórico coletivo de previsões (só no servidor, NUNCA com prefixo VITE_):
# JSON inteiro da conta de serviço (Firebase Console → Configurações → Contas de serviço → Gerar nova chave privada).
# Cadastre apenas na Vercel (Environment Variables) como FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=

# Contador de eventos de uso (só no servidor). Senha longa à sua escolha, usada pra ler os números:
#   https://SEU-SITE/api/eventos?dias=7&key=SUA_SENHA
# Cadastre apenas na Vercel (Environment Variables) como EVENTOS_KEY.
EVENTOS_KEY=
