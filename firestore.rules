rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa lê e grava somente o próprio documento
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favorites', 'routines', 'updatedAt'])
        && request.resource.data.favorites is list
        && request.resource.data.routines is list
        && request.resource.data.favorites.size() <= 200
        && request.resource.data.routines.size() <= 50;
    }

    // Cofre do SitPass: somente texto cifrado (a criptografia é feita no aparelho)
    match /users/{uid}/private/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && docId == 'sitpass';
      allow create, update: if request.auth != null && request.auth.uid == uid && docId == 'sitpass'
        && request.resource.data.keys().hasOnly(['v', 'salt', 'iv', 'ct', 'updatedAt'])
        && request.resource.data.v == 1
        && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 64
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 20000;
    }

    // Histórico coletivo de previsões: só a API do servidor (Admin SDK) acessa
    match /predicoes/{id} {
      allow read, write: if false;
    }

    // Relatos de lotação e contagem de eventos: só o servidor (Admin SDK) lê e grava.
    match /lotacao/{id} {
      allow read, write: if false;
    }
    match /eventos/{id} {
      allow read, write: if false;
    }
  }
}
